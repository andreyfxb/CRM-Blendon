# Copie como .env na raiz. Nunca envie o .env para GitHub ou conversas.
ADMIN_USERNAME=admin
# Gere no terminal local: python -m backend.security
ADMIN_PASSWORD_HASH=
# Origem sem /CRM-Blendon/ e sem barra final. Separe várias origens por vírgula.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://andreyfxb.github.io
DATABASE_PATH=./data/axion.sqlite3
# Configure apenas no servidor. Pode iniciar sem estes três para testar login/CRM.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
# Não é preciso META_ACCESS_TOKEN para receber/verificar os eventos.
# Para assinar o app à conta WhatsApp, use o token no painel/ambiente seguro da Meta.
